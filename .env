# SAGPT Backend Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Volcengine API Configuration
VOLCENGINE_API_KEY=your_volcengine_api_key_here
VOLCENGINE_API_BASE_URL=https://api.volcengine.com/coding-plan

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Database Configuration
DATABASE_PATH=./data/sagpt.db

# Log Configuration
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:5173,https://sagpt.com