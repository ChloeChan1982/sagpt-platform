# =============================================================================
# SAGPT Backend Environment Configuration
# =============================================================================

# =============================================================================
# ZHIPU AI (智谱 GLM) - Default LLM Provider (RECOMMENDED)
# 官网: https://open.bigmodel.cn/dev/api
# 特点: 中文能力强、GLM-4-flash免费(128K tokens/day)、性价比最高
# =============================================================================
AI_PROVIDER=zhipu

ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_CHAT_MODEL=glm-4-flash
ZHIPU_EMBEDDING_MODEL=embedding-2

# 智谱AI模型选项:
# ZHIPU_CHAT_MODEL=glm-4-flash              # 免费模型，推荐用于日常任务
# ZHIPU_CHAT_MODEL=glm-4                     # 旗舰模型，免费5M tokens/day
# ZHIPU_CHAT_MODEL=glm-4-plus                # 增强模型，适合复杂任务

# =============================================================================
# 其他 AI 提供商 (Fallback Options)
# SiliconFlow: 性价比高，9B以下免费 (existing)
# DeepSeek: 极致低价，V4-Flash仅¥0.1/百万token (existing)
# Aliyun: 企业级稳定，200万token免费额度 (existing)
# OpenAI: 保留选项，复杂英语任务备用 (existing)
# =============================================================================

# 选择 AI 提供商 (siliconflow / deepseek / aliyun / openai / zhipu)
# AI_PROVIDER=zhipu

# =============================================================================
# 方案1: 硅基流动 SiliconFlow (推荐 - 性价比最高，9B以下免费)
# 官网: https://cloud.siliconflow.cn
# 特点: 无月费、小模型永久免费、大模型低价、兼容OpenAI API
# =============================================================================
OPENAI_API_KEY=sk-your-siliconflow-api-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V2.5
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
USE_FREE_MODEL_TIER=true
FREE_MODEL=Qwen/Qwen2.5-7B-Instruct

# 硅基流动其他模型选项:
# OPENAI_MODEL=Qwen/Qwen2.5-72B-Instruct    # 通义千问72B，中文很强
# OPENAI_MODEL=deepseek-ai/DeepSeek-R1      # 推理模型，数学/代码最强
# OPENAI_MODEL=THUDM/glm-4-9b-chat          # 智谱小模型，免费
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5  # 英文向量模型

# =============================================================================
# 方案2: DeepSeek 官方 API (极致低价，V4-Flash仅¥0.1/百万token)
# 官网: https://platform.deepseek.com
# 特点: 全球最低价、推理能力顶尖、但充值需国际信用卡
# =============================================================================
# AI_PROVIDER=deepseek
# OPENAI_API_KEY=sk-your-deepseek-api-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# EMBEDDING_MODEL=text-embedding-3-large
# USE_FREE_MODEL_TIER=false

# DeepSeek 模型选项:
# OPENAI_MODEL=deepseek-chat           # 通用对话，最快
# OPENAI_MODEL=deepseek-reasoner       # R1推理模型，最强逻辑
# OPENAI_MODEL=deepseek-v4-flash       # 超低价，日常够用

# =============================================================================
# 方案3: 阿里云百炼 (企业级稳定，大厂背书)
# 官网: https://bailian.aliyun.com
# 特点: 稳定性99.9%、国内支付、200万token免费额度、生态最全
# =============================================================================
# AI_PROVIDER=aliyun
# OPENAI_API_KEY=sk-your-dashscope-api-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
# EMBEDDING_MODEL=text-embedding-v3
# USE_FREE_MODEL_TIER=false

# 阿里云百炼模型选项:
# OPENAI_MODEL=qwen-plus           # 均衡之选，¥0.8/百万token
# OPENAI_MODEL=qwen-max          # 最强能力，¥11.25/百万token
# OPENAI_MODEL=qwen-flash        # 超低价，¥0.15/百万token
# OPENAI_MODEL=deepseek-r1       # 百炼上的DeepSeek，¥4/百万token

# =============================================================================
# 方案4: OpenAI 官方 (保留选项)
# =============================================================================
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-large
# USE_FREE_MODEL_TIER=false

# =============================================================================
# 数据库配置 (Docker Compose 默认)
# =============================================================================
DATABASE_URL=postgresql://sagpt:sagpt123@db:5432/sagpt
REDIS_URL=redis://redis:6379/0

# =============================================================================
# CORS - 允许 Readdy 前端域名访问
# =============================================================================
ALLOWED_ORIGINS=https://sagpt.com,https://www.sagpt.com,http://localhost:3000,http://localhost:5173

# =============================================================================
# 安全密钥 (生产环境务必修改为随机强密码)
# =============================================================================
API_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# =============================================================================
# AI 匹配配置
# =============================================================================
MATCH_TOP_K=5
MATCH_MIN_SCORE=0.6

# Stripe Checkout
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_ALLOWED_PRICE_IDS=price_1TYj5JABXtDkfWuyQ4FD7AxQ,price_1TYj6KABXtDkfWuyfS7nqBG6,price_1TYjBgABXtDkfWuyIfvwPG96,price_1TYjDAABXtDkfWuyuVp5Slhz,price_1TYjEmABXtDkfWuyzVy2tFmM,price_1TYjFfABXtDkfWuyv9p5AvoC
STRIPE_SUCCESS_URL=https://www.sagpt.com/pricing?success=true
STRIPE_CANCEL_URL=https://www.sagpt.com/pricing?canceled=true
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
RESEND_API_KEY=re_your_resend_api_key
AUTH_FROM_EMAIL=SAGPT <account@mail.sagpt.com>
AUTH_COOKIE_DOMAIN=.sagpt.com
APP_BASE_URL=https://www.sagpt.com
API_BASE_URL=https://api.sagpt.com

# =============================================================================
# WeChat Mini Program
# =============================================================================
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_CONTACTED_TEMPLATE_ID=your_contacted_template_id
WECHAT_COMPLETED_TEMPLATE_ID=your_completed_template_id
MINI_SESSION_DAYS=30
UPLOAD_DIR=/var/data/sagpt-uploads

# =============================================================================
# Google Workspace Gmail (NEW - Email Automation)
# =============================================================================
GMAIL_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json
GMAIL_SENDER_EMAIL=sagpt@sagpt.com
GMAIL_SENDER_NAME=SAGPT

# Gmail sending limits (B2B outreach):
# - Daily limit: Start 20, ramp to 30-40, max 50/day
# - Sending window: 9:00 AM - 5:00 PM recipient local time
# - Randomize: Each email +/- 1 hour to avoid spam detection
# - Avoid: Weekends, local holidays

# =============================================================================
# Google Sheets CRM (NEW - Lightweight CRM)
# =============================================================================
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_CREDENTIALS=base64-encoded-service-account-credentials

# Google Sheets tabs:
# - Leads: Advisor lead management (20 columns)
# - Email Logs: Email sending and tracking (8 columns)
# - Daily Run Logs: Discovery metrics (9 columns)

# CRM Strategy:
# - Use Google Sheets as CRM initially (free, no migration needed)
# - FUTURE: Migrate to HubSpot when volume justifies ($100+/month)
