page {
  background: #f7fafc;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 28rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.muted {
  color: #64748b;
  font-size: 28rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

input,
textarea,
picker {
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 20rpx;
  width: 100%;
}

textarea {
  min-height: 220rpx;
}

button.primary {
  background: #0f766e;
  border-radius: 12rpx;
  color: #ffffff;
  font-weight: 700;
}

button.secondary {
  background: #e6fffb;
  border-radius: 12rpx;
  color: #0f766e;
}

.row {
  display: flex;
  gap: 16rpx;
}

.row button {
  flex: 1;
}

.status {
  background: #ecfeff;
  border-radius: 999rpx;
  color: #0f766e;
  display: inline-block;
  font-size: 24rpx;
  padding: 8rpx 18rpx;
}

.error {
  background: #fff1f2;
  border: 1rpx solid #fecdd3;
  border-radius: 12rpx;
  color: #e11d48;
  margin: 20rpx 0;
  padding: 20rpx;
}
