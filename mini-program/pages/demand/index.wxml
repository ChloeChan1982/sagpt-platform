<view class="page">
  <view class="title">咨询登记</view>
  <view class="muted">提交后工作人员会通过微信或电话联系确认，不公开展示</view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="card form">
    <view class="field">
      <text class="label">公司名称</text>
      <input placeholder="请输入公司名称" value="{{form.company_name}}" data-field="company_name" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="label">目标国家</text>
      <input placeholder="例如：新加坡、卡塔尔、阿联酋" value="{{form.target_country}}" data-field="target_country" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="label">行业</text>
      <picker mode="selector" range="{{industries}}" bindchange="onIndustryChange">
        <view class="picker">{{form.industry || '请选择行业'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">服务场景</text>
      <picker mode="selector" range="{{scenarios}}" bindchange="onScenarioChange">
        <view class="picker">{{form.scenario || '请选择服务场景'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">预算范围</text>
      <picker mode="selector" range="{{budgets}}" bindchange="onBudgetChange">
        <view class="picker">{{form.budget_range || '请选择预算范围'}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">咨询事项说明</text>
      <textarea maxlength="500" placeholder="请说明目标市场、想了解的问题和联系时间" value="{{form.description}}" data-field="description" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="label">联系微信/手机号</text>
      <input placeholder="请填写微信或手机号" value="{{form.wechat_phone}}" data-field="wechat_phone" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="label">联系电话</text>
      <input placeholder="请填写联系电话" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
      <button class="secondary" open-type="getPhoneNumber" bindgetphonenumber="bindPhone">授权填入手机号</button>
    </view>

    <view class="field">
      <text class="label">邮箱（选填）</text>
      <input placeholder="便于发送后续确认信息" value="{{form.email}}" data-field="email" bindinput="onInput" />
    </view>

    <checkbox-group bindchange="onPrivacyChange">
      <label class="privacy">
        <checkbox value="accepted" checked="{{form.privacy_accepted}}" />
        <text>我已阅读并同意</text>
        <text class="link" bindtap="openPrivacy">隐私政策</text>
      </label>
    </checkbox-group>

    <button class="primary" loading="{{submitting}}" bindtap="submitDemand">提交咨询</button>
  </view>
</view>
