<view class="page">
  <view class="title">我的需求</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:for="{{demands}}" wx:key="id" class="card item" bindtap="openDetail" data-id="{{item.id}}">
    <view class="item-title">{{item.company_name}}</view>
    <view class="muted">{{item.target_country}} · {{item.industry}} · {{item.scenario}}</view>
    <view class="status">{{statusText[item.status] || item.status}}</view>
  </view>
  <view wx:if="{{!loading && demands.length === 0}}" class="muted empty">暂无需求</view>
</view>
