<view class="page">
  <view wx:if="{{loading}}" class="card muted">加载中...</view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>
  <view wx:elif="{{demand}}" class="card detail">
    <view class="detail-header">
      <view class="title">{{demand.company_name}}</view>
      <view class="status">{{statusLabel}}</view>
    </view>
    <view class="row"><text>目标国家</text><text>{{demand.target_country}}</text></view>
    <view class="row"><text>行业 / 场景</text><text>{{demand.industry}} / {{demand.scenario}}</text></view>
    <view class="row"><text>预算</text><text>{{demand.budget_range}}</text></view>
    <view class="row"><text>联系方式</text><text>{{demand.phone}} / {{demand.wechat_phone}}</text></view>
    <view class="section-title">咨询事项说明</view>
    <view class="paragraph">{{demand.description}}</view>
  </view>
</view>
