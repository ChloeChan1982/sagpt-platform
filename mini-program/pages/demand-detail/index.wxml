<view class="page">
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{demand}}" class="card">
    <view class="title">{{demand.company_name}}</view>
    <view class="status">{{statusText[demand.status] || demand.status}}</view>
    <view class="section">
      <view class="muted">目标国家</view>
      <view>{{demand.target_country}}</view>
    </view>
    <view class="section">
      <view class="muted">行业 / 场景</view>
      <view>{{demand.industry}} · {{demand.scenario}}</view>
    </view>
    <view class="section">
      <view class="muted">预算</view>
      <view>{{demand.budget_range}}</view>
    </view>
    <view class="section">
      <view class="muted">联系方式</view>
      <view>{{demand.wechat_phone}} / {{demand.phone}}</view>
    </view>
    <view class="section">
      <view class="muted">需求描述</view>
      <view>{{demand.description}}</view>
    </view>
  </view>
</view>
